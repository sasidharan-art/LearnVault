# ==========================================================
# LEARNVAULT RENDER PRODUCTION
#
# Add these in Render -> LearnVault API -> Environment.
# Never commit real passwords / secrets.
# ==========================================================

NODE_ENV=production
SERVE_FRONTEND=false

# Add this AFTER Vercel creates your public frontend domain.
FRONTEND_URL=https://YOUR-LEARNVAULT-PROJECT.vercel.app
CORS_ORIGINS=https://YOUR-LEARNVAULT-PROJECT.vercel.app
ALLOW_VERCEL_PREVIEWS=false

# Cloud MySQL
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=learnvault_db

# Many cloud MySQL providers require TLS.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Optional. If your provider gives a CA certificate:
# base64 encode the PEM contents and paste the result here.
DB_SSL_CA_BASE64=

DB_CONNECTION_LIMIT=5

JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1d

# Vercel /api proxy keeps the auth cookie first-party.
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

OTP_DEV_MODE=false

# Brevo SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LearnVault <your-verified-sender@example.com>
