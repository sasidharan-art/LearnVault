# ==========================================================
# LEARNVAULT LOCAL DEVELOPMENT
# Copy to backend/.env and fill local values.
# DO NOT commit backend/.env.
# ==========================================================

NODE_ENV=development
PORT=5000
SERVE_FRONTEND=true

FRONTEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5000
ALLOW_VERCEL_PREVIEWS=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=learnvault_db
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_BASE64=
DB_CONNECTION_LIMIT=10

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1d

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

OTP_DEV_MODE=true

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LearnVault <your-verified-sender@example.com>
